generator client {
  provider = "prisma-client-js"
  output   = "../src/db/prisma"
}

datasource db {
  provider = "mysql"
}

model admin {
  id            String           @id @default(ulid())
  first_name    String
  last_name     String?
  password      String?
  mobile_number String?
  country_code  String?
  email         String           @unique
  location      String?
  joining_date  DateTime?
  role_id       String?
  status        employee_status? @default(unassigned)
  avatar        String?
  employee_id   String?          @unique
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  role          role?            @relation(fields: [role_id], references: [id])

  @@index([role_id], map: "admin_role_id_fkey")
}

model admin_dismissed {
  id             String    @id @default(ulid())
  first_name     String
  last_name      String?
  password       String?
  mobile_number  String?
  country_code   String?
  email          String    @unique
  is_super_admin Boolean   @default(true)
  location       String?
  joining_date   DateTime?
  role           String?
  employee_id    String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
}

model system_config {
  id         String   @id @default(ulid())
  key        String   @unique
  value      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model icon {
  id             String         @id @default(ulid())
  name           String?
  bucket_key     String
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  faq_categories faq_category[]

  @@fulltext([name])
}

model vertical {
	id             String          @id @default(ulid())
	name           String          @unique
	status         vertical_status @default(active)
	display_order  Int             @default(999)
	created_at     DateTime        @default(now())
	updated_at     DateTime        @updatedAt
	boxes          box[]
	clients        client[]
	faq_categories faq_category[]

	@@index([name])
}

model client {
  id                      String                   @id @default(ulid())
  name                    String
  client_display_id       String                   @unique
  organization_name       String?
  country                 String?
  state                   String?
  email                   String?
  password                String?
  mobile_number           String?
  country_code            String?
  status                  client_status            @default(active)
  created_at              DateTime                 @default(now())
  updated_at              DateTime                 @updatedAt
  vertical_id             String?
  profile_pic             String?
  boxes                   box[]
  vertical                vertical?                @relation(fields: [vertical_id], references: [id])
  vertical_delivery_consumers vertical_delivery_consumer[]
  vertical_delivery_employees vertical_delivery_employee[]
  restaurants             restaurant[]
  notifications           notification[]
  medical_employees       vertical_medical_employee[]
  medical_departments     vertical_medical_department[]
  medical_consumers       vertical_medical_consumer[]
  hospitality_floors      vertical_hospitality_floor[] @relation("ClientToHospitalityFloor")

  @@unique([vertical_id, email])
  @@index([name])
  @@index([organization_name])
  @@index([country])
  @@index([state])
  @@index([email])
  @@index([mobile_number])
}

model client_deleted {
  id                String   @id @default(ulid())
  name              String
  client_display_id String
  organization_name String?
  country           String?
  state             String?
  email             String?
  mobile_number     String?
  country_code      String?
  vertical_id       String?
  vertical_name     String?
  profile_pic       String?
  x_primary_key     String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@map("client_deleted")
}

model faq_category {
  id              String                  @id @default(ulid())
  name            String
  name_normalized String
  icon_id         String?
  vertical_id     String
  description     String?
  status          faq_category_status     @default(active)
  index           Int
  created_at      DateTime                @default(now())
  updated_at      DateTime                @updatedAt
  icon            icon?                   @relation(fields: [icon_id], references: [id])
  vertical        vertical                @relation(fields: [vertical_id], references: [id], onDelete: Cascade)
  questions       faq_question_category[]

  @@unique([vertical_id, name_normalized])
  @@index([name])
  @@index([description])
  @@index([icon_id], map: "faq_category_icon_id_fkey")
  @@index([vertical_id], map: "faq_category_vertical_id_fkey")
}

model faq_question {
  id                String                         @id @default(ulid())
  question          String
  answer            String                         @db.LongText
  publishing_status faq_question_publishing_status @default(draft)
  status            faq_category_status            @default(active)
  attachments       Json?
  created_at        DateTime                       @default(now())
  updated_at        DateTime                       @updatedAt
  categories        faq_question_category[]

  @@index([question])
}

model faq_question_category {
  id          String       @id @default(ulid())
  question_id String
  category_id String
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  category    faq_category @relation(fields: [category_id], references: [id], onDelete: Cascade)
  question    faq_question @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@index([category_id], map: "faq_question_category_category_id_fkey")
  @@index([question_id], map: "faq_question_category_question_id_fkey")
}

model role {
  id               String      @id @default(ulid())
  name             String
  name_normalized  String      @unique
  is_super_admin   Boolean     @default(false)
  permissions_json Json
  status           role_status @default(active)
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt
  admins           admin[]

  @@index([name])
}

model box {
  id             String     @id @default(ulid())
  name           String?
  box_display_id String     @unique
  vertical_id    String?
  client_id      String?    @map("customer_id")
  status         box_status @default(active)

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  vehicle_number String?

  telemetry box_telemetry_latest?

  connection_employee_id String?
  connection_employee    vertical_delivery_employee? @relation("box_connection", fields: [connection_employee_id], references: [id])
  medical_connection_employee_id String?
  medical_connection_employee    vertical_medical_employee? @relation("medical_box_connection", fields: [medical_connection_employee_id], references: [id])
  client                 client?                 @relation(fields: [client_id], references: [id])
  vertical               vertical?               @relation(fields: [vertical_id], references: [id])
  lock                   box_lock?

  boxes                            vertical_delivery_consumer_box[] @relation("vertical_delivery_consumer_boxes")
  vertical_delivery_employee_boxes vertical_delivery_employee_box[] @relation("vertical_delivery_employee_boxes")
  restaurant_boxes             restaurant_box[]
  medical_employee_boxes       vertical_medical_employee_box[] @relation("vertical_medical_employee_boxes")
  medical_consumer_boxes       vertical_medical_consumer_box[] @relation("vertical_medical_consumer_boxes")
  medical_department_boxes     vertical_medical_department_box[]
  hospitality_floor_boxes      vertical_hospitality_floor_box[] @relation("BoxToHospitalityFloor")

  @@index([client_id], map: "box_client_id_fkey")
  @@index([vertical_id], map: "box_vertical_id_fkey")
  @@index([connection_employee_id], map: "box_connection_employee_id_fkey")
  @@index([medical_connection_employee_id], map: "box_medical_connection_employee_id_fkey")
}

model restaurant {
  id               String                   @id @default(ulid())
  name             String
  client_id        String?
  created_at       DateTime                 @default(now())
  updated_at       DateTime                 @updatedAt
  city             String?
  google_place_id  String?
  latitude         Float?
  line_one         String?
  line_two         String?
  longitude        Float?
  pincode          String?
  state            String?
  status           restaurant_status        @default(active)
  employees        vertical_delivery_employee[]
  client           client?                  @relation(fields: [client_id], references: [id])
  restaurant_boxes restaurant_box[]

  @@index([client_id], map: "restaurant_client_id_fkey")
}

model vertical_delivery_employee {
  id                              String                           @id @default(ulid())
  first_name                      String
  last_name                       String
  country_code                    String
  mobile_number                   String
  email                           String                           // 1. Remove @unique
  password                        String?
  employee_display_id             String                           // 2. Remove @unique
  joining_date                    DateTime                         @default(now())
  client_id                       String?
  restaurant_id                   String?
  role                            client_employee_role
  status                          employee_status                  @default(unassigned)
  created_at                      DateTime                         @default(now())
  updated_at                      DateTime                         @updatedAt
  profile_pic                     String?
  connected_boxes                 box[]                            @relation("box_connection")
  client                          client?                          @relation(fields: [client_id], references: [id])
  restaurant                      restaurant?                      @relation(fields: [restaurant_id], references: [id])
  vertical_delivery_employee_boxes vertical_delivery_employee_box[] @relation("vertical_delivery_employee_boxes")

  // 3. Define composite uniqueness rules scoped under tenant client_id
  @@unique([client_id, email])
  @@unique([client_id, employee_display_id])
  @@unique([client_id, country_code, mobile_number]) // Optional: if mobile must be unique per client
  
  @@index([client_id], map: "vertical_delivery_employee_client_id_fkey")
  @@index([restaurant_id], map: "vertical_delivery_employee_restaurant_id_fkey")
  @@map("vertical_delivery_employee")
}


model vertical_delivery_employee_box {
  id          String                       @id @default(ulid())
  employee_id String?
  box_id      String
  created_at  DateTime                     @default(now())
  updated_at  DateTime                     @updatedAt
  status      employee_box_status          @default(shared)
  access      employee_box_access          @default(direct)
  box         box                          @relation("vertical_delivery_employee_boxes", fields: [box_id], references: [id], onDelete: Cascade)
  employee    vertical_delivery_employee?  @relation("vertical_delivery_employee_boxes", fields: [employee_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, box_id])
  @@index([box_id], map: "vertical_delivery_employee_box_box_id_fkey")
  @@index([employee_id], map: "vertical_delivery_employee_box_employee_id_fkey")
  @@map("vertical_delivery_employee_box")
}

model restaurant_box {
  id            String                @id @default(ulid())
  restaurant_id String
  box_id        String
  created_at    DateTime              @default(now())
  updated_at    DateTime              @updatedAt
  status        restaurant_box_status @default(shared)
  box           box                   @relation(fields: [box_id], references: [id], onDelete: Cascade)
  restaurant    restaurant            @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([box_id], map: "restaurant_box_box_id_fkey")
  @@index([restaurant_id], map: "restaurant_box_restaurant_id_fkey")
}

model vertical_delivery_employee_deleted {
  id                  String   @id @default(ulid())
  first_name          String
  last_name           String
  country_code        String
  mobile_number       String
  email               String
  employee_display_id String
  joining_date        DateTime
  client_name         String
  role_name           String
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  profile_pic         String?
  client_id           String?
  x_primary_key       String?

  @@map("vertical_delivery_employee_deleted")
}

model restaurant_deleted {
  id              String   @id @default(ulid())
  name            String
  client_id       String?
  client_name     String?
  manager_id      String?
  manager_name    String?
  city            String?
  google_place_id String?
  latitude        Float?
  line_one        String?
  line_two        String?
  longitude       Float?
  pincode         String?
  state           String?
  x_primary_key   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

model box_deleted {
  id             String   @id @default(ulid())
  name           String?
  box_display_id String
  vertical_id    String?
  vertical_name  String?
  client_id      String?
  client_name    String?
  vehicle_number String?
  x_primary_key  String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

model vertical_delivery_consumer {
  id           String                          @id @default(ulid())
  full_name    String
  country_code String
  phone        String
  status       delivery_consumer_status        @default(pending)
  client_id    String?
  created_at   DateTime                        @default(now())
  updated_at   DateTime                        @updatedAt
  client       client?                         @relation(fields: [client_id], references: [id])
  boxes        vertical_delivery_consumer_box[] @relation("vertical_delivery_consumer_boxes")

  @@unique([phone, country_code])
  @@index([client_id], map: "vertical_delivery_consumer_client_id_fkey")
  @@map("vertical_delivery_consumer")
}

model vertical_delivery_consumer_box {
  id          String                    @id @default(ulid())
  consumer_id String
  box_id      String
  created_at  DateTime                  @default(now())
  updated_at  DateTime                  @updatedAt
  box         box                       @relation("vertical_delivery_consumer_boxes", fields: [box_id], references: [id], onDelete: Cascade)
  consumer    vertical_delivery_consumer @relation("vertical_delivery_consumer_boxes", fields: [consumer_id], references: [id], onDelete: Cascade)

  @@index([box_id], map: "vertical_delivery_consumer_box_box_id_fkey")
  @@index([consumer_id], map: "vertical_delivery_consumer_box_consumer_id_fkey")
}

model box_lock {
  id             String          @id @default(ulid())
  box_id         String          @unique
  lock_status    box_lock_status @default(unlocked)
  created_at     DateTime        @default(now())
  updated_status DateTime        @updatedAt
  box            box             @relation(fields: [box_id], references: [id], onDelete: Cascade)
}

model notification {
  id              String            @id @default(ulid())
  client_id       String
  box_id          String?
  box_display_id  String?
  box_name        String?
  restaurant_name String?
  type            notification_type @default(notification)
  title           String
  description     String            @db.Text
  is_read         Boolean           @default(false)
  is_dismissed    Boolean           @default(false)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  client          client            @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([client_id])
  @@index([box_id])
  @@index([is_read])
  @@index([is_dismissed])
}

enum employee_status {
  active
  suspended
  unassigned
}

enum faq_category_status {
  active
  suspended
  deleted
}

enum faq_question_publishing_status {
  draft
  published
}

enum role_status {
  active
  deleted
}

enum box_status {
  active
  suspended
  unassigned
}

enum box_lock_status {
  locked
  unlocked
  not_available
  offline
}

enum box_health_status {
  critical
  healthy
  attention
}

enum box_connection_status {
  connected
  disconnected
  unknown
}

enum client_employee_role {
  manager
  delivery
}

enum client_status {
  active
  inactive
  suspended
}

enum restaurant_status {
  active
  suspended
}

enum restaurant_box_status {
  shared
  not_shared
  blocked
}

enum employee_box_status {
  shared
  blocked
}

enum employee_box_access {
  direct
  public
  all_employees
}

enum hardware_state {
  on
  off
  unknown
}

model box_telemetry_latest {
  id                    String                 @id @default(ulid())
  box_id                String                 @unique
  health_status         box_health_status?     @default(healthy)
  power_status          hardware_state?        @default(unknown)
  battery_percentage    Int?
  memory_percentage     Int?
  ext_temp              Int?
  zone1_temp            Int?
  zone2_temp            Int?
  ioniser_status        hardware_state?        @default(unknown)
  adas_status           hardware_state?        @default(unknown)
  bluetooth_status      hardware_state?        @default(unknown)
  camera_status         hardware_state?        @default(unknown)
  gps_status            hardware_state?        @default(unknown)
  gyrosensor_status     hardware_state?        @default(unknown)
  port_big_status       hardware_state?        @default(unknown)
  port_small_status     hardware_state?        @default(unknown)
  save_to_memory_status hardware_state?        @default(unknown)
  sim_status            hardware_state?        @default(unknown)
  solar_status          hardware_state?        @default(unknown)
  turn_signal_status    hardware_state?        @default(unknown)
  wifi_status           hardware_state?        @default(unknown)
  advert_screen_status  hardware_state?        @default(unknown)
  light_status          hardware_state?        @default(unknown)
  dual_zone_status      hardware_state?        @default(unknown)
  connection_status     box_connection_status? @default(unknown)

  updated_at DateTime @updatedAt

  box box @relation(fields: [box_id], references: [id], onDelete: Cascade)
}

// ── Medical Vertical ─────────────────────────────────────────────────────────

model vertical_medical_department {
  id              String                          @id @default(ulid())
  name            String
  client_id       String?
  status          medical_department_status        @default(active)
  created_at      DateTime                         @default(now())
  updated_at      DateTime                         @updatedAt
  client          client?                          @relation(fields: [client_id], references: [id])
  employees       vertical_medical_employee[]
  department_boxes vertical_medical_department_box[]

  @@unique([client_id, name])
  @@index([client_id], map: "vertical_medical_department_client_id_fkey")
  @@map("vertical_medical_department")
}

model vertical_medical_department_box {
  id            String                           @id @default(ulid())
  department_id String
  box_id        String
  created_at    DateTime                         @default(now())
  updated_at    DateTime                         @updatedAt
  status        medical_department_box_status     @default(shared)
  department    vertical_medical_department       @relation(fields: [department_id], references: [id], onDelete: Cascade)
  box           box                              @relation(fields: [box_id], references: [id], onDelete: Cascade)

  @@unique([department_id, box_id])
  @@index([box_id], map: "vertical_medical_department_box_box_id_fkey")
  @@index([department_id], map: "vertical_medical_department_box_department_id_fkey")
  @@map("vertical_medical_department_box")
}

model vertical_medical_employee {
  id                  String                          @id @default(ulid())
  first_name          String
  last_name           String
  country_code        String
  mobile_number       String
  email               String
  password            String?
  employee_display_id String
  joining_date        DateTime                        @default(now())
  client_id           String?
  department_id       String?
  role                medical_employee_role
  status              employee_status                 @default(unassigned)
  profile_pic         String?
  created_at          DateTime                        @default(now())
  updated_at          DateTime                        @updatedAt
  client              client?                         @relation(fields: [client_id], references: [id])
  department          vertical_medical_department?     @relation(fields: [department_id], references: [id])
  connected_boxes     box[]                           @relation("medical_box_connection")
  employee_boxes      vertical_medical_employee_box[]  @relation("vertical_medical_employee_boxes")

  @@unique([client_id, email])
  @@unique([client_id, employee_display_id])
  @@unique([client_id, country_code, mobile_number])
  @@index([client_id], map: "vertical_medical_employee_client_id_fkey")
  @@index([department_id], map: "vertical_medical_employee_department_id_fkey")
  @@map("vertical_medical_employee")
}

model vertical_medical_employee_box {
  id          String                         @id @default(ulid())
  employee_id String?
  box_id      String
  status      medical_employee_box_status    @default(shared)
  access      medical_employee_box_access    @default(direct)
  created_at  DateTime                       @default(now())
  updated_at  DateTime                       @updatedAt
  box         box                            @relation("vertical_medical_employee_boxes", fields: [box_id], references: [id], onDelete: Cascade)
  employee    vertical_medical_employee?     @relation("vertical_medical_employee_boxes", fields: [employee_id], references: [id], onDelete: SetNull)

  @@unique([employee_id, box_id])
  @@index([box_id], map: "vertical_medical_employee_box_box_id_fkey")
  @@index([employee_id], map: "vertical_medical_employee_box_employee_id_fkey")
  @@map("vertical_medical_employee_box")
}

model vertical_medical_consumer {
  id           String                            @id @default(ulid())
  full_name    String
  country_code String
  phone        String
  status       medical_consumer_status           @default(pending)
  client_id    String?
  created_at   DateTime                          @default(now())
  updated_at   DateTime                          @updatedAt
  client       client?                           @relation(fields: [client_id], references: [id])
  boxes        vertical_medical_consumer_box[]    @relation("vertical_medical_consumer_boxes")

  @@unique([phone, country_code])
  @@index([client_id], map: "vertical_medical_consumer_client_id_fkey")
  @@map("vertical_medical_consumer")
}

model vertical_medical_consumer_box {
  id          String                      @id @default(ulid())
  consumer_id String
  box_id      String
  created_at  DateTime                    @default(now())
  updated_at  DateTime                    @updatedAt
  box         box                         @relation("vertical_medical_consumer_boxes", fields: [box_id], references: [id], onDelete: Cascade, map: "vertical_medical_consumer_box_box_fkey")
  consumer    vertical_medical_consumer   @relation("vertical_medical_consumer_boxes", fields: [consumer_id], references: [id], onDelete: Cascade, map: "vertical_medical_consumer_box_consumer_fkey")

  @@index([box_id])
  @@index([consumer_id])
}

model vertical_medical_employee_deleted {
  id                  String   @id @default(ulid())
  first_name          String
  last_name           String
  country_code        String
  mobile_number       String
  email               String
  employee_display_id String
  joining_date        DateTime
  client_name         String
  role_name           String
  department_name     String?
  profile_pic         String?
  client_id           String?
  x_primary_key       String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@map("vertical_medical_employee_deleted")
}

model vertical_medical_department_deleted {
  id              String   @id @default(ulid())
  name            String
  client_id       String?
  client_name     String?
  x_primary_key   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

// ── Medical Enums ────────────────────────────────────────────────────────────

enum medical_department_status {
  active
  suspended
}

enum medical_department_box_status {
  shared
  not_shared
  blocked
}

enum medical_employee_role {
  manager
  delivery
}

enum medical_employee_box_status {
  shared
  blocked
}

enum medical_employee_box_access {
  direct
  public
  all_employees
}

enum medical_consumer_status {
  pending
  delivered
  cancelled
}

// ── Shared Enums ─────────────────────────────────────────────────────────────

enum delivery_consumer_status {
  pending
  delivered
  cancelled
}

enum notification_type {
  warning
  error
  success
  notification
}

enum vertical_status {
  active
  deleted
}

// Hospitality Models & Enums
enum hospitality_floor_status {
  active
  suspended
}

enum hospitality_floor_box_status {
  shared
  not_shared
  blocked
}

// Hospitality Floor
model vertical_hospitality_floor {
  id            String                           @id @default(ulid())
  name          String
  client_id     String?
  status        hospitality_floor_status         @default(active)
  created_at    DateTime                         @default(now())
  updated_at    DateTime                         @updatedAt
  client        client?                          @relation("ClientToHospitalityFloor", fields: [client_id], references: [id])
  boxes         vertical_hospitality_floor_box[]

  @@unique([client_id, name])
  @@index([client_id], map: "vertical_hospitality_floor_client_id_fkey")
  @@map("vertical_hospitality_floor")
}

// Hospitality Floor-Box Assignment
model vertical_hospitality_floor_box {
  id            String                         @id @default(ulid())
  floor_id      String
  box_id        String
  room          String?                        // Room number/identifier
  created_at    DateTime                       @default(now())
  updated_at    DateTime                       @updatedAt
  status        hospitality_floor_box_status   @default(shared)
  floor         vertical_hospitality_floor     @relation(fields: [floor_id], references: [id], onDelete: Cascade)
  box           box                            @relation("BoxToHospitalityFloor", fields: [box_id], references: [id], onDelete: Cascade)

  @@unique([floor_id, box_id])
  @@index([box_id], map: "vertical_hospitality_floor_box_box_id_fkey")
