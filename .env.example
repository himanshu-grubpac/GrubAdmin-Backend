# Local development defaults (copy to .env and adjust). Standard ports: BE 8000, Hospitality FE 3000.
PORT=8000
NODE_ENV=development

DATABASE_URL=mysql://grub_user:StrongUserPass%40123@localhost:3307/grub_db
MONGO_URI=mongodb://mongo_root:StrongMongoRoot%40123@localhost:27017/grubpac_logs?authSource=admin

# Email — optional in dev for hospitality (getHospitalityMailFrom falls back to support@sqaby.com)
MAIL=your_email@example.com
MAIL_PASS=your_email_password_or_app_password

AUTH_SECRET=change_me_to_a_random_uuid
DELIVERY_AUTH_SECRET=change_me_to_a_random_string_at_least_64_chars
MEDICAL_AUTH_SECRET=change_me_to_a_random_string_at_least_64_chars
CAMPING_AUTH_SECRET=change_me_to_a_random_string_at_least_64_chars
HOSPITALITY_AUTH_SECRET=change_me_to_a_random_string_at_least_64_chars

SEED_EMAIL=seed_admin@example.com
SEED_PASSWORD=seed_password
SEED_NAME=FirstName
SEED_LAST_NAME=LastName
SEED_COUNTRY_CODE=+1
SEED_MOBILE_NUMBER=5551234567

AWS_KEY=your_aws_access_key_id
AWS_SECRET=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your_s3_bucket_name
# Camp consumer camera S3 prefix (objects at {prefix}/camp-consumer/{box_id}/cam{N}/...)
CAMERA_S3_PREFIX=camp-camera
# Medical mobile location share — Option A uses native OS share; web page base is optional/unused
# MEDICAL_MOBILE_SHARE_BASE_URL=https://share.example.com/medical
# Optional simulator GPS defaults when gps_available=true but lat/lng omitted
# SIMULATOR_DEFAULT_LAT=12.9716
# SIMULATOR_DEFAULT_LNG=77.5946

# Hospitality portal URLs — optional in dev (backend defaults to http://localhost:3000 when all three are unset)
# Remove any legacy hardcoded IPs (e.g. 13.127.79.155) from local .env when developing on localhost.
HOSPITALITY_FRONTEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CLIENT_DASHBOARD_URL=http://localhost:3000

# CORS — include hospitality dev origin; localhost:3000 is also always allowed in app.ts
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

JWT_ACCESS_TOKEN_EXPIRY=86400
JWT_REFRESH_TOKEN_EXPIRY=604800
